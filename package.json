{
  "name": "proto-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev:admin": "nx run-many -t serve -p admin admin-api --parallel=2",
    "dev:all": "pnpm dev:infra && pnpm dev:admin",
    "build:admin": "nx run-many -t build -p admin admin-api",
    "test": "nx run-many -t test --all",
    "lint": "nx run-many -t lint --all",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "dev:infra": "docker compose -f compose/compose.dev.yml up -d postgres",
    "dev:infra:down": "docker compose -f compose/compose.dev.yml down"
  },
  "dependencies": {
    "@angular/animations": "22.1.0",
    "@angular/cdk": "22.1.0",
    "@angular/common": "22.1.0",
    "@angular/compiler": "22.1.0",
    "@angular/core": "22.1.0",
    "@angular/forms": "22.1.0",
    "@angular/platform-browser": "22.1.0",
    "@angular/router": "22.1.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/client": "6.19.3",
    "@taiga-ui/cdk": "5.17.0",
    "@taiga-ui/core": "5.17.0",
    "@taiga-ui/icons": "5.17.0",
    "@taiga-ui/kit": "5.17.0",
    "@taiga-ui/layout": "5.17.0",
    "@taiga-ui/styles": "5.17.0",
    "ag-grid-angular": "36.0.2",
    "ag-grid-community": "36.0.2",
    "ag-grid-enterprise": "36.0.2",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.0",
    "@angular-devkit/core": "22.1.0",
    "@angular-devkit/schematics": "22.1.0",
    "@angular/build": "22.1.0",
    "@angular/cli": "22.1.0",
    "@angular/compiler-cli": "22.1.0",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.28",
    "@nx/angular": "23.1.0",
    "@nx/esbuild": "23.1.0",
    "@nx/eslint": "23.1.0",
    "@nx/jest": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/nest": "23.1.0",
    "@nx/node": "23.1.0",
    "@nx/web": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/node": "24.2.1",
    "eslint": "9.33.0",
    "jest": "30.0.5",
    "nx": "23.1.0",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "prisma": "6.19.3",
    "sass": "1.90.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.4",
