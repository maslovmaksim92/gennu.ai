{
  "name": "proto-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev:admin": "nx run-many -t serve -p admin admin-api --parallel=2",
    "dev:all": "pnpm dev:infra && pnpm dev:admin",
    "build:admin": "nx run-many -t build -p admin admin-api",
    "i18n:extract:admin": "nx run admin:extract-i18n",
    "nx:check": "nx show projects && nx show project admin && nx show project admin-api",
    "test": "nx run-many -t test --all",
    "lint": "nx run-many -t lint --all",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "format:ts": "prettier \"**/*.ts\" --write",
    "format:ts:check": "prettier \"**/*.ts\" --check",
    "check:templates": "node scripts/check-inline-templates.mjs",
    "check": "pnpm format:check && pnpm check:templates",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:seed": "node --env-file=.env --import=tsx prisma/seed.ts",
    "db:setup": "pnpm db:generate && pnpm db:push && pnpm db:seed",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "dev:infra": "docker compose -f compose/compose.dev.yml up -d postgres",
    "dev:infra:down": "docker compose -f compose/compose.dev.yml down"
  },
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/localize": "^22.1.2",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/client": "^6.19.3",
    "@taiga-ui/addon-mobile": "^5.20.0",
    "@taiga-ui/addon-table": "^5.20.0",
    "@taiga-ui/cdk": "^5.20.0",
    "@taiga-ui/core": "^5.20.0",
    "@taiga-ui/event-plugins": "^5.0.0",
    "@taiga-ui/experimental": "^5.20.0",
    "@taiga-ui/i18n": "^5.20.0",
    "@taiga-ui/icons": "^5.20.0",
    "@taiga-ui/kit": "^5.20.0",
    "@taiga-ui/layout": "^5.20.0",
    "@taiga-ui/polymorpheus": "^5.0.1",
    "@taiga-ui/styles": "^5.20.0",
    "ag-grid-angular": "^36.0.2",
    "ag-grid-community": "^36.0.2",
    "ag-grid-enterprise": "^36.0.2",
    "bcryptjs": "^3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.28",
    "@nx/angular": "^23.1.0",
    "@nx/esbuild": "^23.1.0",
    "@nx/eslint": "^23.1.0",
    "@nx/jest": "^23.1.0",
    "@nx/js": "^23.1.0",
    "@nx/nest": "^23.1.0",
    "@nx/node": "^23.1.0",
    "@nx/web": "^23.1.0",
    "@nx/workspace": "^23.1.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "eslint": "^9.33.0",
    "jest": "^30.0.5",
    "jsdom": "^28.0.0",
    "nx": "^23.1.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "prisma": "^6.19.3",
    "sass": "^1.90.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.4",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "prisma": {
    "seed": "node --env-file=.env --import=tsx prisma/seed.ts"
  }
}
