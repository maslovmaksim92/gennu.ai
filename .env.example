NODE_ENV=development
ADMIN_PORT=3001
# The CORS origin of the admin. Required when NODE_ENV=production.
ADMIN_WEB_URL=http://localhost:4200
DATABASE_URL=postgresql://proto:proto@localhost:5432/proto
# Checked at startup — the API refuses to boot without it. At least 32 characters.
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-of-32-plus-characters
ADMIN_EMAIL=admin@proto.local
ADMIN_PASSWORD=change-me-now
# Checked at startup too. Exactly 64 hex characters: `openssl rand -hex 32`.
INTEGRATION_ENCRYPTION_KEY=replace-with-64-hex-characters
OPENAI_API_KEY=sk-replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.6-terra
