{
  "name": "admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/admin/src",
  "projectType": "application",
  "i18n": {
    "sourceLocale": "en-US"
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "options": {
        "browser": "apps/admin/src/main.ts",
        "index": "apps/admin/src/index.html",
        "tsConfig": "apps/admin/tsconfig.app.json",
        "polyfills": ["@angular/localize/init"],
        "localize": false,
        "styles": [
          "styles/tailwind.css",
          "libs/ui/atlas/src/styles.scss",
          "apps/admin/src/styles.scss",
          "styles/ag-grid-theme.scss",
          "styles/taiga-ui-theme.scss"
        ],
        "outputPath": "dist/apps/admin"
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "buildTarget": "admin:build",
        "proxyConfig": "apps/admin/proxy.conf.json",
        "port": 4200,
        "host": "0.0.0.0"
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "admin:build",
        "format": "xlf2",
        "outputPath": "apps/admin/src/locale",
        "outFile": "messages.xlf"
      }
    }
  }
}
