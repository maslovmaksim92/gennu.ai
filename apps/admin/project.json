{
  "name": "admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/admin/src",
  "projectType": "application",
  "i18n": {
    "sourceLocale": "en-US",
    "locales": {
      "ru-RU": "apps/admin/src/locale/messages.ru-RU.xlf"
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "options": {
        "browser": "apps/admin/src/main.ts",
        "index": "apps/admin/src/index.html",
        "tsConfig": "apps/admin/tsconfig.json",
        "polyfills": ["@angular/localize/init"],
        "localize": false,
        "assets": [
          {
            "glob": "**/*.svg",
            "input": "node_modules/@taiga-ui/icons/src",
            "output": "assets/taiga-ui/icons"
          }
        ],
        "styles": [
          "@taiga-ui/styles/taiga-ui-theme.less",
          "@taiga-ui/addon-mobile/styles/taiga-ui-mobile.less",
          "styles/tailwind.css",
          "libs/ui/atlas/src/styles.scss",
          "apps/admin/src/styles.scss",
          "styles/taiga-ui-theme.scss"
        ],
        "outputPath": "dist/apps/admin"
      },
      "configurations": {
        "development": {
          "localize": ["ru-RU"],
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "buildTarget": "admin:build",
        "proxyConfig": "apps/admin/proxy.conf.json",
        "port": 4200,
        "host": "0.0.0.0"
      },
      "configurations": {
        "development": {
          "buildTarget": "admin:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "admin:build",
        "format": "xlf2",
        "outputPath": "apps/admin/src/locale",
        "outFile": "messages.xlf"
      }
    }
  }
}
